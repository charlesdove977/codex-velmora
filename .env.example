# Leave blank for local console-only delivery. Never put private medical details in demo forms.
RESEND_API_KEY=
# Practice destination for all request notifications.
SPA_INBOX_EMAIL=
# Verified Resend sender, e.g. Velmora <appointments@your-domain.com>
RESEND_FROM_EMAIL=
# Optional Resend audience for newsletter contacts. Without this, requests reach the practice inbox.
RESEND_AUDIENCE_ID=
# Standalone Node server deployment settings.
HOST=0.0.0.0
PORT=4321
