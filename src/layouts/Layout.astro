---
import '@fontsource/cormorant-garamond/latin-400.css';import '@fontsource/cormorant-garamond/latin-400-italic.css';import '@fontsource/manrope/latin-400.css';import '@fontsource/manrope/latin-500.css';import '@fontsource/manrope/latin-600.css';
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';import bodyFont from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';import '../styles/global.css';import Nav from '../components/Nav.astro';import Footer from '../components/Footer.astro';import {site,brandStyle} from '../config/site';
interface Props{title:string;description?:string;hero?:boolean;noindex?:boolean;schema?:Record<string,unknown>|Record<string,unknown>[];hideBook?:boolean;}
const {title,description=`Physician-led aesthetic care in ${site.address.city}. Explore considered treatments, clear pricing and a consultation built around you.`,hero=false,noindex=false,schema=[],hideBook=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url);const business={'@context':'https://schema.org','@type':['MedicalBusiness','LocalBusiness'],name:site.name,url:site.url,description:site.demoNotice,telephone:site.phone,address:{'@type':'PostalAddress',streetAddress:site.address.street,addressLocality:site.address.city,addressRegion:site.address.region,postalCode:site.address.postalCode,addressCountry:site.address.country},geo:{'@type':'GeoCoordinates',...site.geo},openingHoursSpecification:site.hours.filter(h=>h.open!==null).map(h=>({'@type':'OpeningHoursSpecification',dayOfWeek:h.day,opens:`${String(h.open).padStart(2,'0')}:00`,closes:`${h.close}:00`}))};
---
<!doctype html><html lang="en" style={brandStyle}><head><meta charset="UTF-8"/><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin/><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content={site.colors.bone}/><title>{title} | {site.name}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} | ${site.name}`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/og.png',site.url)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{noindex&&<meta name="robots" content="noindex,follow"/>}{[business,...(Array.isArray(schema)?schema:[schema])].map(s=><script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g,'\\u003c')}/>)}</head><body><a class="skip-link" href="#main">Skip to content</a><Nav hero={hero}/><main id="main"><slot/></main><Footer/>{!hideBook&&<aside class="mobile-book-bar" aria-label="Book a consultation"><small>Your next chapter.<br/>Consultations from $0</small><a class="button" href="/book">Book a consultation ↗</a></aside>}</body></html>
<script>
if(matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)').matches){Promise.all([import('lenis'),import('gsap'),import('gsap/ScrollTrigger')]).then(([{default:Lenis},{gsap},{ScrollTrigger}])=>{gsap.registerPlugin(ScrollTrigger);const lenis=new Lenis({duration:1.15,smoothWheel:true,anchors:true});lenis.on('scroll',ScrollTrigger.update);gsap.ticker.add(t=>lenis.raf(t*1000));gsap.ticker.lagSmoothing(0);document.querySelectorAll('.reveal').forEach(el=>gsap.from(el,{y:24,opacity:0,duration:1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 92%',once:true}}));document.querySelectorAll('picture img[loading=lazy]').forEach(el=>gsap.from(el,{clipPath:'inset(10% 0 10% 0)',duration:1.1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 95%',once:true}}));document.querySelectorAll('.hero-line > span').forEach((el,i)=>gsap.from(el,{yPercent:105,opacity:0,duration:1,delay:i*.12,ease:'power3.out'}));document.querySelectorAll<HTMLElement>('.magnetic').forEach(b=>{b.addEventListener('pointermove',e=>{if(e.pointerType!=='mouse')return;const r=b.getBoundingClientRect();gsap.to(b,{x:(e.clientX-r.left-r.width/2)*.08,y:(e.clientY-r.top-r.height/2)*.12,duration:.6});});b.addEventListener('pointerleave',()=>gsap.to(b,{x:0,y:0,duration:.8}));});});}
</script>
