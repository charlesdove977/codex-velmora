---
import {site,addressLine} from '../config/site';
import Form from './Form';
---
<footer class="site-footer"><div class="container"><div class="footer-grid"><div><a class="wordmark" href="/">{site.shortName}<small>Aesthetics</small></a><p>Care with intention.<br/>Beauty that feels like you.</p><p style="margin-top:1rem">{addressLine}</p><a href={`https://maps.google.com/?q=${encodeURIComponent(addressLine)}`}>View {site.address.city} map ↗</a><a href={site.phoneHref}>{site.phone}</a><details class="footer-hours"><summary>Practice hours · {site.timezoneLabel} time</summary>{site.hours.map(h=><p>{h.day}: {h.open===null?'Closed':`${h.open}:00–${h.close}:00`}</p>)}</details></div><div><h2>Explore</h2>{[['Treatments','/treatments'],['Our approach','/about'],['Results','/results'],['Pricing','/pricing'],['Membership','/membership'],['Gift cards','/gift-cards']].map(([n,u])=><a href={u}>{n}</a>)}</div><div><h2>Here for you</h2>{[['Book a consultation','/book'],['Treatment match','/quiz'],['Support & aftercare','/support'],['Your questions','/faq'],['Journal','/journal'],['Contact','/contact']].map(([n,u])=><a href={u}>{n}</a>)}{site.socials.map(s=><a href={s.url} rel="noopener noreferrer">{s.name} ↗</a>)}</div><div><h2>Skin Notes</h2><p style="margin-bottom:1.5rem">A thoughtful note on skin, care and making time for yourself.</p><Form client:visible kind="newsletter"/></div></div><div class="footer-bottom"><div>© {new Date().getFullYear()} {site.name}<br/>{site.demoNotice}<br/>Individual results vary. Educational content is not medical advice.</div><nav class="footer-legal" aria-label="Legal">{[['Privacy','/privacy'],['Terms','/terms'],['Medical disclaimer','/medical-disclaimer'],['Accessibility','/accessibility'],['Policies','/support/policies']].map(([n,u])=><a href={u}>{n}</a>)}</nav></div></div></footer>
<style>.site-footer :global(.request-form label){color:var(--bone)}.site-footer :global(.request-form .muted){color:var(--stone)}.site-footer :global(.request-form .button){border-color:var(--stone);background:var(--bone);color:var(--ink)}.site-footer :global(.request-form a){display:inline!important;color:var(--bone)!important}</style>
