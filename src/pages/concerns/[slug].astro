---
import Layout from '../../layouts/Layout.astro';import PageIntro from '../../components/PageIntro.astro';import TreatmentCard from '../../components/TreatmentCard.astro';import CTA from '../../components/CTA.astro';import Button from '../../components/Button.astro';import {concerns,treatments} from '../../data/treatments';
export function getStaticPaths(){return concerns.map(c=>({params:{slug:c.slug},props:{c}}));}const {c}=Astro.props;
---
<Layout title={c.name} description={c.description}><PageIntro title={c.name} eyebrow="Start with your concern" description={c.description} items={[{name:'Treatments',url:'/treatments'},{name:c.name}]}/><section class="container section" style="padding-top:0"><div class="section-head"><h2>A few paths<br/><em>to explore.</em></h2><p class="small muted">These are discussion starters. An assessment determines what is appropriate for you.</p></div><div class="grid-3">{treatments.filter(t=>t.concerns.includes(c.slug)).map(t=><TreatmentCard treatment={t}/>)}</div></section><section class="section sand"><div class="container split"><h2>You do not need<br/><em>all the answers.</em></h2><div class="stack"><p>Tell us what you have noticed, what you have tried and how you want to feel. We will explain your options, including when a different specialist or no procedure may be the better choice.</p><Button href="/quiz">Find your starting point</Button></div></div></section><CTA/></Layout>
