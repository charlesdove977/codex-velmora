---
import Layout from '../../layouts/Layout.astro';import PageIntro from '../../components/PageIntro.astro';import HelpSearch from '../../components/HelpSearch';import Form from '../../components/Form';import {site} from '../../config/site';import {aftercare} from '../../data/help';
---
<Layout title="Support & aftercare" description={`Find booking answers, treatment aftercare and practice policies. Search the ${site.shortName} help center or send a question to the care coordinator.`}><PageIntro title="Here for the details." eyebrow="The care desk" description="A practical answer, a little reassurance, a clear next step. Search our guides or send the team a question." items={[{name:'Support'}]}/><section class="section container" style="padding-top:0"><HelpSearch client:load/><div id="before-your-visit" class="notice" style="margin-top:3rem"><strong>Before your visit</strong><p>Bring photo identification, your medication list and details of previous procedures to your private consultation. Do not stop prescribed medicines without advice. Allow 20 minutes for the initial conversation.</p></div><div style="margin-top:4rem"><h2 style="margin-bottom:2rem">Care, continued.</h2><div class="grid-3">{aftercare.map(g=><a class="care-guide" href={`/support/aftercare/${g.slug}`}><h3>{g.name} ↗</h3><p class="small muted">{g.intro}</p></a>)}</div></div></section><section class="section sand"><div class="container split" style="align-items:start"><div class="stack"><span class="eyebrow">A human conversation</span><h2>Still wondering<br/><em>about something?</em></h2><p>We aim to reply within two business days. Include your booking reference if you have one. Please keep medical history and sensitive information out of this form.</p><a class="button ghost" href={site.phoneHref}>{site.phone}</a><a class="button link" href="/contact">View practice hours ↗</a><p class="small muted">This form is not monitored for urgent symptoms. Seek immediate medical care for an emergency.</p></div><Form kind="support" client:visible/></div></section></Layout>
