---
import Layout from '../../../layouts/Layout.astro';import PageIntro from '../../../components/PageIntro.astro';import Button from '../../../components/Button.astro';import {aftercare} from '../../../data/help';
export function getStaticPaths(){return aftercare.map(g=>({params:{slug:g.slug},props:{g}}));}const {g}=Astro.props;
---
<Layout title={`${g.name} aftercare`} description={g.intro}><PageIntro title={`${g.name} aftercare`} eyebrow="Care continues at home" description={g.intro} items={[{name:'Support',url:'/support'},{name:g.name+' aftercare'}]}/><section class="section container" style="padding-top:0"><div class="rich-copy"><p class="notice">General educational guidance. Your clinician’s written discharge instructions take priority because products, devices and individual needs differ.</p><h2>A gentle plan for recovery.</h2><ol>{g.steps.map(s=><li style="margin:1rem 0">{s}</li>)}</ol><h2>When to get help</h2><p>{g.urgent}</p><p>For severe or sudden symptoms, call 911 or seek emergency care. Do not wait for a website form response. For non-urgent questions, contact your treating clinician.</p><h2>Your follow-up matters</h2><p>Keep the review appointment recommended for your treatment. Bring questions and describe any changes, including when they started. Photographs and medical details should be shared only through a secure clinical channel.</p><div class="button-row"><Button href="/support" variant="ghost">Back to the care desk</Button><button class="button" onclick="window.print()">Print this guide</button></div></div></section></Layout>
