---
import Layout from '../layouts/Layout.astro';import Button from '../components/Button.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import TreatmentCard from '../components/TreatmentCard.astro';import SpecStrip from '../components/SpecStrip.astro';import PriceTable from '../components/PriceTable.astro';import MembershipCard from '../components/MembershipCard.astro';import Accordion from '../components/Accordion.astro';import BeforeAfter from '../components/BeforeAfter';import TestimonialCarousel from '../components/TestimonialCarousel';import Tabs from '../components/Tabs';import Form from '../components/Form';import Modal from '../components/Modal.astro';import HeroScene from '../components/three/HeroScene';import Method from '../components/Method.astro';import {site} from '../config/site';
---
<Layout title="Design language" noindex><div class="container page-top"><Breadcrumbs items={[{name:'Design language'}]}/><span class="eyebrow">The {site.shortName} collection</span><h1>Calm, in every detail.</h1><p class="intro">A living collection of the colors, type and interactions that shape our practice.</p></div><section class="container section"><span class="eyebrow">01 / Palette & type</span><div class="grid-3">{Object.entries(site.colors).map(([n,c])=><div style={`padding:2rem;background:${c};color:${['ink','muted','goldText','error'].includes(n)?site.colors.bone:site.colors.ink}`}><strong>{n}</strong><br/>{c}</div>)}</div><div class="stack" style="margin-top:3rem"><h2>Medical precision.<br/><em>Hotel calm.</em></h2><p class="intro">Cormorant Garamond brings softness. Manrope gives every practical detail a clear voice.</p><span class="badge">Consultation first</span><div class="button-row"><Button href="/book">Book a consultation</Button><Button variant="ghost" href="/quiz">Find your treatment</Button><Button variant="link" href="/about">Our approach</Button></div></div></section><section class="container section border-top"><span class="eyebrow">02 / Signature care</span><div class="grid-3"><TreatmentCard treatment={{slug:'neuromodulators',name:'A softer expression',category:'Injectables',price:14,unit:'/unit',benefit:'Thoughtful care for expression lines.',image:'skin'}}/><MembershipCard name="Essential" price={149} description="A monthly moment for your skin." benefits={['One signature facial','10% off selected skincare','A personal care review']}/><div><h3>Your questions,<br/>considered.</h3><Accordion items={[{q:'Where do I begin?',a:'Start with a consultation. We will discuss your priorities, health and expectations before recommending treatment.'},{q:'Is there time to recover?',a:'Recovery depends on the treatment and your skin. Your provider will explain a realistic plan.'}]}/></div></div><SpecStrip specs={{duration:'20–30 minutes',discomfort:'Brief pinches',downtime:'Usually minimal',onset:'3–14 days',longevity:'Typically 3–4 months'}}/><PriceTable rows={[{name:'Virtual consultation',price:'$0',note:'20 minutes'},{name:'In-person consultation',price:'$50',note:'Credited to treatment'}]}/></section><section class="container section border-top"><div class="grid-2"><BeforeAfter client:visible/><div class="stack"><Tabs client:visible items={[{label:'Before',text:'Bring your questions and your current skincare routine.'},{label:'During',text:'Your provider explains each step and checks your comfort.'},{label:'After',text:'Follow your personalized aftercare plan and contact us with questions.'}]}/><Modal><p>Consultations begin with listening. Your treatment plan is a shared decision.</p></Modal><div class="toast" role="status">Your request has been received.</div><span class="badge">Illustrative study</span></div></div><div style="margin-top:4rem"><TestimonialCarousel client:visible/></div></section><section class="container section border-top"><div class="split"><div><span class="eyebrow">03 / Forms & feedback</span><h2>A simple<br/><em>conversation.</em></h2><p class="small muted" style="margin-top:2rem">Required fields show clear inline feedback. Keyboard focus remains visible.</p></div><Form client:visible kind="support"/></div></section><section class="container section border-top"><span class="eyebrow">04 / Light in motion</span><HeroScene client:visible/></section><Method/></Layout>
