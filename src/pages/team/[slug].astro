---
import Layout from '../../layouts/Layout.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import Picture from '../../components/Picture.astro';import Button from '../../components/Button.astro';import TreatmentCard from '../../components/TreatmentCard.astro';import {team} from '../../data/team';import {treatments} from '../../data/treatments';
export function getStaticPaths(){return team.map(p=>({params:{slug:p.slug},props:{p}}));}const {p}=Astro.props;const schema={'@context':'https://schema.org','@type':p.slug==='elena-marquez'?'Physician':'Person',name:p.name,description:`Fictional demonstration profile. ${p.credentials}. ${p.bio}`};

import {site} from '../../config/site';
---
<Layout title={p.name} description={`${p.name}, ${p.credentials}. Meet a fictional member of the ${site.shortName} concept care team and explore their approach.`} schema={schema}><header class="page-top container"><Breadcrumbs items={[{name:'About',url:'/about'},{name:p.name}]}/><div class="split"><div class="portrait-arch"><Picture name={p.image} alt={`Licensed stock portrait representing fictional clinician ${p.name}`} eager/></div><div class="stack"><span class="eyebrow">{p.credentials}</span><h1>{p.name}</h1><p class="intro">“{p.philosophy}”</p><p class="muted">{p.bio}</p><p><strong>Focus:</strong> {p.focus}</p><p class="small muted">{p.years} years of experience in this sample profile.</p><Button href={`/book?provider=${p.slug}`}>Request a consultation</Button><p class="demo-label">Fictional identity and credentials. Photograph shows a stock model, not a practicing {site.shortName} clinician.</p></div></div></header><section class="section container border-top"><div class="section-head"><h2>Explore their<br/><em>areas of care.</em></h2></div><div class="grid-3">{treatments.filter(t=>t.providers.includes(p.slug)).slice(0,3).map(t=><TreatmentCard treatment={t}/>)}</div></section></Layout>
