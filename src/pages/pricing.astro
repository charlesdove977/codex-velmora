---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import PriceTable from '../components/PriceTable.astro';import Button from '../components/Button.astro';import Accordion from '../components/Accordion.astro';import {treatments,categories} from '../data/treatments';

import {site} from '../config/site';
---
<Layout title="Transparent pricing" description={`See ${site.shortName}’s illustrative treatment prices, from $14 per unit for Botox to personalized skin and wellness care. Receive a written quote before treatment.`}><PageIntro title="Clarity is part of care." eyebrow="Pricing, without the guesswork" description="Every starting price is a conversation, not a commitment. Your written plan explains the product, the amount and the total before you decide." items={[{name:'Pricing'}]}/><section class="container section" style="padding-top:0"><div class="notice">Demonstration pricing for a fictional practice. Virtual consultation: $0. In-person consultation: $50, credited toward eligible treatment within 60 days.</div>{categories.map(c=><section style="margin-top:4rem"><h2>{c}</h2><PriceTable rows={treatments.filter(t=>t.category===c).map(t=>({name:t.name,price:`$${t.price}`,note:t.unit.replace(' / ','Per '),url:`/treatments/${t.slug}`}))}/></section>)}</section><section class="section sand"><div class="container split"><div><h2>A regular ritual.<br/><em>A considered value.</em></h2><div class="button-row"><Button href="/membership">Explore memberships</Button></div></div><Accordion items={[{q:'Will I receive a quote first?',a:'Yes. Your clinician explains the proposed care and itemized cost before you consent. No treatment or payment is required at consultation.'},{q:'Are financing plans available?',a:'This concept does not offer financing or process payments. A live practice would explain any approved financing terms before application.'},{q:'Can I combine promotions?',a:'Membership benefits cannot be combined with other offers unless a written promotion explicitly allows it. Your coordinator can explain the total before you book.'}]}/></div></section></Layout>
