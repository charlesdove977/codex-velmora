---
import Layout from '../../layouts/Layout.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import Picture from '../../components/Picture.astro';import Button from '../../components/Button.astro';import SpecStrip from '../../components/SpecStrip.astro';import Accordion from '../../components/Accordion.astro';import TreatmentCard from '../../components/TreatmentCard.astro';import BeforeAfter from '../../components/BeforeAfter';import CTA from '../../components/CTA.astro';import {treatments,concerns} from '../../data/treatments';import {team} from '../../data/team';import {site} from '../../config/site';
export function getStaticPaths(){return treatments.map(t=>({params:{slug:t.slug},props:{t}}));}const {t}=Astro.props;
const schema=[{'@context':'https://schema.org','@type':'MedicalProcedure',name:t.name,description:t.benefit,howPerformed:t.how,preparation:t.before,followup:t.after},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:t.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Home',item:site.url},{name:'Treatments',item:site.url+'/treatments'},{name:t.name,item:site.url+'/treatments/'+t.slug}].map((x,i)=>({'@type':'ListItem',position:i+1,...x}))}];
---
<Layout title={t.name} description={`${t.benefit} Explore pricing from $${t.price}, preparation, recovery and your consultation options in ${site.address.city}.`} schema={schema}><header class="page-top container"><Breadcrumbs items={[{name:'Treatments',url:'/treatments'},{name:t.name}]}/><div class="split"><div><span class="eyebrow">{t.category}</span><h1>{t.name}</h1><p class="intro muted" style="margin-top:2rem">{t.benefit}</p><div class="button-row"><Button href={`/book?treatment=${t.slug}`}>Explore your options</Button><span class="small">From ${t.price}{t.unit}</span></div></div><div class="detail-image"><Picture name={t.image} alt={t.imageAlt} eager/></div></div><SpecStrip specs={t.specs}/><p class="demo-label">General planning estimates. Suitability, recovery and results vary.</p></header><section class="section container split"><div><span class="eyebrow">The intention</span><h2>What it can<br/><em>help address.</em></h2><div class="button-row">{t.concerns.map(slug=><a class="tab" href={`/concerns/${slug}`}>{concerns.find(c=>c.slug===slug)?.name}</a>)}</div></div><div class="stack"><h3>How it works</h3><p>{t.how}</p><details class="accordion"><summary>Risks & considerations</summary><div class="answer">{t.risk}</div></details></div></section><section class="section sand"><div class="container"><div class="section-head"><h2>Your appointment,<br/><em>made clear.</em></h2></div><div class="grid-3">{[{n:'01',title:'Before',copy:t.before},{n:'02',title:'During',copy:t.during},{n:'03',title:'After',copy:t.after}].map(s=><article class="stack"><span class="eyebrow">{s.n}</span><h3>{s.title}</h3><p class="small muted">{s.copy}</p></article>)}</div></div></section><section class="section container split"><div class="stack"><span class="eyebrow">Setting expectations</span><h2>A conversation<br/><em>about change.</em></h2><p>We assess your starting point and discuss a realistic range of outcomes. Real treatment photographs would be reviewed privately with appropriate consent.</p><p class="notice">This demonstration uses an illustrative image comparison. It does not show a patient or a treatment result.</p></div><BeforeAfter client:visible image={t.image} title={t.name}/></section><section class="section container border-top"><div class="section-head"><h2>Care that may<br/><em>work together.</em></h2><p class="small muted">Timing and combinations require your clinician’s approval.</p></div><div class="grid-3">{treatments.filter(x=>t.pairs.includes(x.slug)).map(x=><TreatmentCard treatment={x}/>)}</div></section><section class="section sand"><div class="container split"><div class="stack"><span class="eyebrow">Clear before you commit</span><h2>From ${t.price}<em>{t.unit}</em></h2><p>{t.pricing}</p><p class="small muted">A $50 in-person consultation is credited to eligible care within 60 days. Virtual consultations are complimentary. No payment is taken with a booking request.</p><Button href={`/book?treatment=${t.slug}`}>Request a consultation</Button></div><div class="stack"><h3>Meet your care team</h3>{team.filter(p=>t.providers.includes(p.slug)).map(p=><a class="care-guide" href={`/team/${p.slug}`}><strong>{p.name} ↗</strong><p class="small muted">{p.credentials}</p></a>)}<p class="demo-label">Fictional clinicians created for this website concept.</p></div></div></section><section class="section container split" style="align-items:start"><div class="stack"><span class="eyebrow">Good questions, clear answers</span><h2>Before you decide.</h2><Button href={`/support/aftercare/${t.categorySlug}`} variant="link">Read aftercare guidance</Button></div><Accordion items={t.faq}/></section><CTA/><aside class="treatment-book"><span>{t.name} <small> · from ${t.price}</small></span><a class="button" href={`/book?treatment=${t.slug}`}>Book a consultation ↗</a></aside></Layout>
<style>.detail-image{height:440px;overflow:hidden;border-radius:48% 48% 0 0}.detail-image :global(img){width:100%;height:100%;object-fit:cover}.page-top .spec-strip{margin-top:3rem}.treatment-book{position:sticky;bottom:0;z-index:39;background:var(--bone);border-top:1px solid var(--line);padding:1rem var(--gutter);display:flex;align-items:center;justify-content:space-between}.treatment-book small{color:var(--muted)}@media(max-width:767px){.detail-image{height:340px}.treatment-book{display:none}}</style>
