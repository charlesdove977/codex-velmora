---
import Layout from '../../layouts/Layout.astro';import PageIntro from '../../components/PageIntro.astro';import TreatmentCard from '../../components/TreatmentCard.astro';import CTA from '../../components/CTA.astro';import {treatments,categories,concerns} from '../../data/treatments';
---
<Layout title="Treatments" description="Explore 13 aesthetic and wellness treatments, with transparent starting prices, recovery guidance and individualized consultation."><PageIntro title="Care, considered." eyebrow="The treatment collection" description="Start with what matters to you. We will help you understand the options, the trade-offs and the right pace." items={[{name:'Treatments'}]}/><section class="container section" style="padding-top:0"><div class="filter-controls"><div class="field"><label for="category">Treatment category</label><select id="category"><option value="">All treatments</option>{categories.map(c=><option>{c}</option>)}</select></div><div class="field"><label for="concern">Your concern</label><select id="concern"><option value="">All concerns</option>{concerns.map(c=><option value={c.slug}>{c.name}</option>)}</select></div></div><p class="small muted" id="filter-count" aria-live="polite">13 treatments to explore</p><div class="grid-3" style="margin-top:2rem;row-gap:3rem">{treatments.map(t=><div data-treatment data-category={t.category} data-concerns={t.concerns.join(',')}><TreatmentCard treatment={t}/></div>)}</div><p id="no-results" class="empty-state" hidden>No treatments match both filters. Try another category or explore all concerns.</p></section><CTA/></Layout>
<script>
const category=document.querySelector<HTMLSelectElement>('#category')!,concern=document.querySelector<HTMLSelectElement>('#concern')!;const update=()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-treatment]').forEach(el=>{el.hidden=Boolean((category.value&&el.dataset.category!==category.value)||(concern.value&&!el.dataset.concerns?.split(',').includes(concern.value)));if(!el.hidden)count++;});document.querySelector('#filter-count')!.textContent=`${count} treatment${count===1?'':'s'} to explore`;document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;};category.addEventListener('change',update);concern.addEventListener('change',update);const q=new URLSearchParams(location.search);concern.value=q.get('concern')||'';update();
</script>
