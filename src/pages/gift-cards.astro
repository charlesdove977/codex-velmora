---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Form from '../components/Form';

import {site} from '../config/site';
---
<Layout title="Gift cards" description={`Request information about a ${site.shortName} gift card. A thoughtful gesture for a facial or consultation, with no payment taken online.`}><PageIntro title="A little time, beautifully given." eyebrow="The gift of care" description="For the person who makes room for everyone else. Let them choose their own ritual." items={[{name:'Gift cards'}]}/><section class="section container split" style="padding-top:0;align-items:start"><div class="stack"><div class="gift"><span class="eyebrow">{site.name}</span><h2>A moment.<br/><em>Just for you.</em></h2><p>THE GIFT OF CONSIDERED CARE</p></div><p>Request a gift value from $50 to $1,000. A coordinator would explain delivery and redemption before purchase. Clinical treatments always require the recipient’s own assessment and consent.</p><p class="notice">This is a gift-card inquiry, not a purchase. No card is charged, and no redeemable balance is created on this demonstration site.</p><p class="small muted">Sample terms: not redeemable for cash except where required by law; no expiration on purchased value. Membership fees and prescription medicines are excluded. The recipient chooses whether to pursue care.</p></div><Form kind="gift-card" client:load/></section></Layout>
<style>.gift{background:var(--ink);color:var(--bone);padding:clamp(2rem,5vw,4rem);aspect-ratio:1.6;display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--gold)}.gift p{font-size:var(--text-xs);letter-spacing:.15em}</style>
