---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Picture from '../components/Picture.astro';import CTA from '../components/CTA.astro';import {team} from '../data/team';

import {site} from '../config/site';
---
<Layout title="Our philosophy & team" description={`Meet the concept behind ${site.shortName}: physician-led planning, thoughtful restraint and a welcoming ${site.address.city} setting.`}><PageIntro title="Expert care. Human warmth." eyebrow={`The ${site.shortName} philosophy`} description="We believe aesthetic care should leave room for your questions, your expression and your own idea of feeling well." items={[{name:'About'}]}/><section class="container section split" style="padding-top:0"><div class="portrait-arch"><Picture name="space" alt="A warm, quiet spa lounge with natural textures" eager/></div><div class="stack"><span class="eyebrow">Medical precision. Hotel calm.</span><h2>Space to feel<br/><em>like yourself.</em></h2><p>{site.shortName} is a concept for a different kind of aesthetic practice: one where clinical detail and personal attention belong together. The setting is calm. The conversation is honest. The plan is yours.</p><p>We start by listening, then explain what is possible, what carries risk and what can wait. A recommendation should make sense to you before it becomes a treatment.</p><p class="notice">{site.shortName} is a fictional demonstration practice. All clinician identities, credentials and experience shown here are sample profiles; portraits are licensed stock models.</p></div></section><section class="section sand"><div class="container grid-3">{[['01 / Listen first','Your priorities guide the conversation. We ask what you want to preserve as carefully as what you want to change.'],['02 / Explain clearly','Understand the product, provider, expected recovery and price. There is always room for another question.'],['03 / Plan thoughtfully','A staged approach can be the right approach. So can referring you elsewhere or deciding against a procedure.']].map(([title,copy])=><article class="stack"><h3>{title}</h3><p class="muted">{copy}</p></article>)}</div></section><section class="section container"><div class="section-head"><div><span class="eyebrow">The people behind the care</span><h2>A thoughtful<br/><em>team.</em></h2></div><p class="small muted">Five fictional profiles, one shared philosophy.</p></div><div class="grid-3" style="row-gap:3rem">{team.map(p=><a href={`/team/${p.slug}`} class="treatment-card"><div class="image-wrap"><Picture name={p.image} alt={`Stock portrait representing ${p.name}, a fictional team member`}/></div><span class="eyebrow" style="margin-top:1.5rem">{p.role}</span><h3>{p.name} ↗</h3><p>{p.credentials}</p></a>)}</div></section><CTA/></Layout>
