---
import Layout from '../layouts/Layout.astro';import Button from '../components/Button.astro';import HeroScene from '../components/three/HeroScene';import TreatmentCard from '../components/TreatmentCard.astro';import Picture from '../components/Picture.astro';import Method from '../components/Method.astro';import BeforeAfter from '../components/BeforeAfter';import TestimonialCarousel from '../components/TestimonialCarousel';import JournalCards from '../components/JournalCards.astro';import CTA from '../components/CTA.astro';import {treatments,concerns}from'../data/treatments';import {site}from'../config/site';
const signature=[treatments[0],treatments[1],treatments[4],treatments[5],treatments[7],treatments[8]];
---
<Layout title={`Physician-led medical spa in ${site.address.city}`} hero description={`Considered aesthetic care in ${site.address.city}. Explore injectables, skin renewal and wellness with clear pricing and a consultation shaped around you.`}><section class="hero"><div class="container hero-grid"><div><span class="eyebrow">{site.address.city}, {site.regionName} · Physician-led aesthetics</span><h1><span class="hero-line"><span>A little</span></span><span class="hero-line"><span>refinement.</span></span><span class="hero-line"><span><em>Entirely you.</em></span></span></h1><p class="intro muted">Thoughtful aesthetic care, a calm place to pause. Designed around your skin and everything that makes you, you.</p><div class="button-row"><Button href="/book" class="magnetic">Book a consultation</Button><Button href="/quiz" variant="link">Find your treatment</Button></div></div><div class="hero-art"><HeroScene client:media="(min-width: 768px)"/><div class="hero-caption">The art of restraint · The science of care</div><span class="art-coordinate" aria-hidden="true">33.49° N<br/>111.92° W</span></div></div><div class="hero-bottom"><span>Medical precision. Hotel calm.</span><a href="#signature">Explore considered care ↓</a><span>A moment for yourself</span></div></section>
<section class="trust-strip"><div class="container"><div><strong>Physician-led</strong><span>Dr. Elena Marquez, MD</span></div><div><strong>15 years</strong><span>Medical director experience*</span></div><div><strong>10,000+</strong><span>Treatments performed*</span></div><div><strong>4.9 / 5</strong><span>Illustrative demo rating*</span></div><div><strong>Carefully selected</strong><span>FDA-cleared device options</span></div></div><p class="demo-label container">*Fictional practice credentials and metrics for this concept. No real review-platform rating is claimed.</p></section>
<section id="signature" class="container section"><div class="section-head reveal"><div><span class="eyebrow">01 / Signature treatments</span><h2>Small details.<br/><em>A considered difference.</em></h2></div><Button href="/treatments" variant="link">Explore all treatments</Button></div><div class="grid-3 signature-grid">{signature.map(t=><TreatmentCard treatment={t}/>)}</div></section>
<section class="section border-top"><div class="container split"><div class="reveal"><span class="eyebrow">02 / Begin with what matters to you</span><h2>Your skin.<br/><em>Your starting point.</em></h2><p class="intro muted" style="margin-top:2rem">You do not need to know the treatment name. Start with what you notice, and we will help make sense of the options.</p></div><div class="concern-selector">{concerns.map((c,i)=><a href={`/concerns/${c.slug}`}><span class="small muted">0{i+1}</span><span>{c.name}</span><span aria-hidden="true">↗</span></a>)}</div></div></section>
<Method/>
<section class="container section"><div class="section-head"><div><span class="eyebrow">03 / The subtle approach</span><h2>Refinement that<br/><em>respects you.</em></h2></div><Button href="/results" variant="link">Explore the studies</Button></div><div class="grid-2"><BeforeAfter client:visible title="A study in skin texture"/><BeforeAfter client:visible image="ritual" title="A study in natural radiance"/></div></section>
<section class="section membership-teaser"><div class="container split"><div class="portrait-arch"><Picture name="treatment" alt="Gentle facial care with a clinician’s gloved hands"/></div><div class="reveal"><span class="eyebrow">The {site.shortName} membership</span><h2>Make care<br/><em>a beautiful habit.</em></h2><p class="intro muted" style="margin-top:2rem">A regular moment for your skin. A plan that keeps your care connected, from your visit to your everyday routine.</p><div class="savings"><span>$149<small> / month</small></span><p>Essential includes a $199 signature facial.<br/>Save $50 each month you use it.</p></div><Button href="/membership">Find your rhythm</Button></div></div></section>
<section class="container section"><div class="split"><div class="reveal"><span class="eyebrow">Medical direction, personal attention</span><h2>An experienced eye.<br/><em>A listening ear.</em></h2><blockquote class="director-quote">“The best plan begins with what you want to keep.”</blockquote><p class="muted">Dr. Elena Marquez, MD<br/>Medical Director</p><p class="small muted" style="margin-top:1rem">Our philosophy is conservative by design. We explain the options, including waiting, so every decision can feel like your own.</p><p class="demo-label" style="margin-top:1rem">Fictional provider profile. Stock portrait.</p><div class="button-row"><Button href="/team/elena-marquez" variant="link">Meet your medical director</Button></div></div><div class="director-image"><Picture name="provider-1" alt="Stock portrait illustrating the fictional medical director"/></div></div></section>
<section class="container section border-top"><TestimonialCarousel client:visible/></section>
<section class="section sand"><div class="container"><div class="section-head"><div><span class="eyebrow">A place to exhale</span><h2>Desert light.<br/><em>A quieter pace.</em></h2></div><p class="muted">Soft textures, warm light and room to feel at ease.<br/>An imagined space for thoughtful care.</p></div><div class="space-grid"><Picture name="space" alt="Illustrative spa lounge with sculptural cream seating"/><Picture name="serum" alt="A glass skincare bottle and pipette in warm light"/><Picture name="desert" alt="Saguaro cacti under an Arizona sky"/></div><p class="demo-label" style="margin-top:1rem">Licensed stock imagery, illustrating the concept space.</p></div></section>
<section class="container section"><div class="section-head"><div><span class="eyebrow">The journal</span><h2>A little knowledge.<br/><em>A clearer choice.</em></h2></div><Button href="/journal" variant="link">All skin notes</Button></div><JournalCards/></section><CTA/></Layout>
<style>.art-coordinate{position:absolute;right:0;top:20%;font-size:var(--text-xs);letter-spacing:.1em;color:var(--muted);writing-mode:vertical-rl}.trust-strip{border-block:1px solid var(--line);padding:2rem 0}.trust-strip>.container:first-child{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem}.trust-strip strong{display:block;font:var(--text-xl) var(--font-display)}.trust-strip span{display:block;font-size:var(--text-xs);color:var(--muted);margin-top:.5rem}.trust-strip .demo-label{margin-top:1.5rem}.signature-grid{row-gap:3.5rem}.concern-selector a{display:flex;align-items:center;gap:1.5rem;padding:1.4rem 0;border-bottom:1px solid var(--line)}.concern-selector a span:nth-child(2){font:var(--text-2xl) var(--font-display);flex:1}.concern-selector a:hover{color:var(--gold-text)}.membership-teaser{background:var(--sand)}.savings{margin:2rem 0;border-block:1px solid var(--line);padding:1.5rem 0}.savings>span{font:var(--text-3xl) var(--font-display)}.savings small{font:var(--text-sm) var(--font-body)}.savings p{font-size:var(--text-sm);color:var(--muted)}.director-quote{font:var(--text-2xl)/1.2 var(--font-display);margin:2rem 0}.director-image{height:620px;overflow:hidden}.director-image :global(img){height:100%;width:100%;object-fit:cover;object-position:top}.space-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:1.5rem}.space-grid :global(picture){display:block;height:300px;overflow:hidden}.space-grid :global(picture:first-child){grid-row:span 2;height:624px}.space-grid :global(img){width:100%;height:100%;object-fit:cover}@media(max-width:767px){.trust-strip>.container:first-child{grid-template-columns:1fr 1fr}.director-image{height:460px}.space-grid{grid-template-columns:1fr 1fr;gap:1rem}.space-grid :global(picture:first-child){grid-column:span 2;grid-row:auto;height:330px}.space-grid :global(picture){height:220px}.art-coordinate{top:10%;right:0}.hero-caption{font-size:var(--text-xs)}}
</style>
