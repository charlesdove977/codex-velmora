---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import MembershipCard from '../components/MembershipCard.astro';import Accordion from '../components/Accordion.astro';import {memberships} from '../data/memberships';
const faq=[{q:'What is the commitment?',a:'The illustrative membership has a three-month initial term, then renews monthly. You can request cancellation with 30 days’ notice after the initial term. This demo does not activate billing.'},{q:'Do unused benefits roll over?',a:'One unused facial may roll into the following month. Treatment credits expire after 90 days and have no cash value. Benefits are personal and cannot be transferred.'},{q:'Is every treatment included?',a:'No. Each tier includes the listed facial and any stated credit. Prescription medicines, laboratory fees and separately priced clinical services are excluded unless your written plan says otherwise.'},{q:'Can I pause my membership?',a:'One pause of up to 60 days may be requested in a 12-month period. Medical circumstances are reviewed individually. Contact the coordinator before your next renewal.'},{q:'How do I join?',a:'Request a membership consultation. The team reviews suitability and the complete written terms before you choose a tier. No membership is purchased on this demonstration site.'}];

import {site} from '../config/site';
---
<Layout title="Membership" description="Explore Essential, Signature and Reserve memberships, from $149 monthly. A consistent facial ritual with clear benefits and straightforward terms."><PageIntro title="Make room for yourself." eyebrow={`The ${site.shortName} membership`} description="A steady rhythm of thoughtful care. Three ways to make your skin ritual part of everyday life." items={[{name:'Membership'}]}/><section class="section container" style="padding-top:0"><div class="grid-3">{memberships.map(m=><MembershipCard {...m}/>)}</div><p class="small muted" style="margin-top:2rem">Essential’s $149 monthly fee is $50 less than the $199 standalone signature facial when used each month. Other savings depend on the benefits you use. All tiers are illustrative; no billing is activated.</p></section><section class="section sand"><div class="container"><div class="section-head"><h2>The details,<br/><em>side by side.</em></h2></div><div class="table-scroll"><table class="price-table"><caption class="sr-only">Membership benefit comparison</caption><thead><tr><th scope="col">Included</th>{memberships.map(m=><th scope="col">{m.name}</th>)}</tr></thead><tbody>{[['Monthly fee','$149','$249','$399'],['Signature facial','One / month','One / month','One / month'],['Treatment credit','—','$50 / month','$175 / month'],['Skincare savings','10%','15%','20%'],['Care planning','Quarterly review','Priority requests','Quarterly consultation']].map(row=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div></div></section><section class="section container split" style="align-items:start"><h2>A little more<br/><em>to know.</em></h2><Accordion items={faq}/></section></Layout>
<style>.table-scroll{overflow-x:auto}.price-table{min-width:600px}</style>
