---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Form from '../components/Form';import {site,addressLine} from '../config/site';
const time=(h:number|null)=>h===null?'Closed':`${h>12?h-12:h}:00 ${h>=12?'pm':'am'}`;
---
<Layout title="Contact & visit" description={`Find the ${site.shortName} concept location in ${site.address.city}, view sample opening hours or send a question to the team.`}><PageIntro title="We would love to hear from you." eyebrow="Come as you are" description="Ask a question, plan a visit or tell us what you are looking for." items={[{name:'Contact'}]}/><section class="section container split" style="padding-top:0;align-items:start"><div class="stack"><h2>In the heart<br/><em>of {site.address.city}.</em></h2><p>{addressLine}</p><p><a href={site.phoneHref}>{site.phone}</a><br/><a href={`mailto:${site.email}`}>{site.email}</a></p><p class="notice">Fictional practice and sample address. No appointments take place at this location.</p><dl class="hours">{site.hours.map(h=><div><dt>{h.day}</dt><dd>{h.open===null?'Closed':`${time(h.open)} – ${time(h.close)}`}</dd></div>)}</dl><p class="small muted">All hours shown in {site.timezoneLabel} time ({site.timezone}).</p><a class="button ghost" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`} target="_blank" rel="noopener noreferrer">View area on map ↗</a></div><div><h2 style="margin-bottom:2rem">A note to the team.</h2><Form kind="contact" client:load/></div></section><section class="container section" style="padding-top:0"><div class="map-panel"><div class="stack"><span class="eyebrow">Find your way</span><h2>{site.address.city},<br/><em>at your pace.</em></h2><p>{addressLine}</p><a class="button" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`} target="_blank" rel="noopener noreferrer">Open location in Google Maps ↗</a><p class="small muted">A sample location for this concept practice.</p></div><div class="map-coordinate" aria-hidden="true"><span>+ {site.geo.latitude.toFixed(4)}° N</span><span>{Math.abs(site.geo.longitude).toFixed(4)}° W</span></div></div><details class="map-details"><summary>Load interactive map</summary><iframe title={`Map of the sample ${site.address.city} location`} data-map-src={`https://maps.google.com/maps?q=${site.geo.latitude},${site.geo.longitude}&z=14&output=embed`} width="100%" height="400" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0;filter:grayscale(1)"></iframe><p class="small muted">If the map does not appear, use the Google Maps link above.</p></details><p class="demo-label">Map shows a sample area only; {site.shortName} is not an operating clinic.</p></section></Layout>
<style>.hours{max-width:420px}.hours div{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:.7rem 0;font-size:var(--text-sm)}.hours dd{margin:0}</style>

<script>
const mapDetails=document.querySelector('.map-details');mapDetails?.addEventListener('toggle',()=>{const frame=mapDetails.querySelector('iframe');if(mapDetails.hasAttribute('open')&&frame&&!frame.hasAttribute('src'))frame.src=frame.dataset.mapSrc!;});
</script>
<style>.map-panel{background:var(--sand);border:1px solid var(--line);padding:clamp(2rem,5vw,5rem);display:flex;justify-content:space-between;gap:2rem;align-items:center}.map-coordinate{display:grid;gap:1rem;font:var(--text-2xl) var(--font-display);color:var(--gold-text)}.map-details{padding:1.5rem 0}.map-details summary{min-height:44px;text-decoration:underline;text-underline-offset:5px}.map-details iframe{margin-top:1rem}@media(max-width:767px){.map-panel{display:block}.map-coordinate{margin-top:2rem}}</style>
